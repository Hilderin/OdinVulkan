// Odin bindings for ImPlot, generated by hand from cimplot.h.
//
// cimplot.h is the C API of ImPlot (https://github.com/cimgui/cimplot),
// itself generated from implot.h. This binding mirrors that C API: it links
// against the static library built from cimplot.cpp + implot.cpp, compiled
// once per platform and dropped next to this file (see build/ for the
// rebuild scripts).
//
// Naming follows the existing imgui.odin binding: the ImPlot_ prefix is
// stripped from functions and ImPlot from types, and the C field names are
// kept as-is. Flag types use the bit_set/Flag pair convention from imgui.odin.
//
// Only the public API is bound. The internal API (ImPlotTick_c, ImPlotAxis_c,
// ImPlotTicker, the ImPool_/ImVector_ internals and the ImPlot*_object
// constructors) is skipped. Integer-typed variants of the plot functions
// (ImS8/ImU8/... ) are omitted; the double, float and getter variants cover
// the common cases.
package implot

import im "../imgui"

when ODIN_OS == .Linux {
	@(require) foreign import stdcpp "system:stdc++"
} else when ODIN_OS == .Darwin {
	@(require) foreign import stdcpp "system:c++"
}

// Default Spec used by the plot function wrappers when no custom Spec is
// provided. It is created lazily on first use via ImPlotSpec_ImPlotSpec(),
// which fills the C defaults (IMPLOT_AUTO). A zeroed Spec{} would have
// LineColor=(0,0,0,0) and LineWeight=0, producing an invisible line.
default_spec: ^Spec = nil

get_default_spec :: proc() -> ^Spec {
	if default_spec == nil {
		default_spec = Spec_ImPlotSpec()
	}
	return default_spec
}

when ODIN_OS == .Windows {
	when ODIN_ARCH == .amd64 {
		@export
		foreign import implotlib "implot_windows_x64.lib"
	} else {
		@export
		foreign import implotlib "implot_windows_arm64.lib"
	}
} else when ODIN_OS == .Linux {
	when ODIN_ARCH == .amd64 {
		@export
		foreign import implotlib "libimplot_linux_x64.a"
	} else {
		@export
		foreign import implotlib "libimplot_linux_arm64.a"
	}
} else when ODIN_OS == .Darwin {
	when ODIN_ARCH == .amd64 {
		@export
		foreign import implotlib "libimplot_macosx_x64.a"
	} else {
		@export
		foreign import implotlib "libimplot_macosx_arm64.a"
	}
}

// Constants
IMPLOT_AUTO :: -1
IMPLOT_MIN_TIME :: 0.0
IMPLOT_MAX_TIME :: 32503680000.0
IMPLOT_LABEL_MAX_SIZE :: 32

// ImPlotAxis: which axes a plot can use.
Axis :: enum i32 {
	X1 = 0,
	X2 = 1,
	X3 = 2,
	Y1 = 3,
	Y2 = 4,
	Y3 = 5,
	Count = 6,
}

// ImPlotProp: a property settable on an ImPlotSpec.
Prop :: enum i32 {
	LineColor = 0,
	LineColors,
	LineWeight,
	FillColor,
	FillColors,
	FillAlpha,
	Marker,
	MarkerSize,
	MarkerSizes,
	MarkerLineColor,
	MarkerLineColors,
	MarkerFillColor,
	MarkerFillColors,
	Size,
	Offset,
	Stride,
	Flags,
}

// ImPlotFlags for BeginPlot.
Flags :: bit_set[Flag; i32]
Flag :: enum i32 {
	NoTitle = 0,
	NoLegend = 1,
	NoMouseText = 2,
	NoInputs = 3,
	NoMenus = 4,
	NoBoxSelect = 5,
	NoFrame = 6,
	Equal = 7,
	Crosshairs = 8,
}
CANVAS_ONLY :: Flags{.NoTitle, .NoLegend, .NoMenus, .NoBoxSelect, .NoMouseText}

// ImPlotAxisFlags for SetupAxis / SetupAxes.
AxisFlags :: bit_set[AxisFlag; i32]
AxisFlag :: enum i32 {
	NoLabel = 0,
	NoGridLines = 1,
	NoTickMarks = 2,
	NoTickLabels = 3,
	NoInitialFit = 4,
	NoMenus = 5,
	NoSideSwitch = 6,
	NoHighlight = 7,
	Opposite = 8,
	Foreground = 9,
	Invert = 10,
	AutoFit = 11,
	RangeFit = 12,
	PanStretch = 13,
	LockMin = 14,
	LockMax = 15,
}
AXIS_FLAGS_LOCK :: AxisFlags{.LockMin, .LockMax}
AXIS_FLAGS_NO_DECORATIONS :: AxisFlags{.NoLabel, .NoGridLines, .NoTickMarks, .NoTickLabels}
AXIS_FLAGS_AUX_DEFAULT :: AxisFlags{.NoGridLines, .Opposite}

// ImPlotSubplotFlags for BeginSubplots.
SubplotFlags :: bit_set[SubplotFlag; i32]
SubplotFlag :: enum i32 {
	NoTitle = 0,
	NoLegend = 1,
	NoMenus = 2,
	NoResize = 3,
	NoAlign = 4,
	ShareItems = 5,
	LinkRows = 6,
	LinkCols = 7,
	LinkAllX = 8,
	LinkAllY = 9,
	ColMajor = 10,
}

// ImPlotLegendFlags for SetupLegend.
LegendFlags :: bit_set[LegendFlag; i32]
LegendFlag :: enum i32 {
	NoButtons = 0,
	NoHighlightItem = 1,
	NoHighlightAxis = 2,
	NoMenus = 3,
	Outside = 4,
	Horizontal = 5,
	Sort = 6,
	Reverse = 7,
}

// ImPlotMouseTextFlags for SetupMouseText.
MouseTextFlags :: bit_set[MouseTextFlag; i32]
MouseTextFlag :: enum i32 {
	NoAuxAxes = 0,
	NoFormat = 1,
	ShowAlways = 2,
}

// ImPlotDragToolFlags for DragPoint / DragLine / DragRect.
DragToolFlags :: bit_set[DragToolFlag; i32]
DragToolFlag :: enum i32 {
	NoCursors = 0,
	NoFit = 1,
	NoInputs = 2,
	Delayed = 3,
}

// ImPlotColormapScaleFlags for ColormapScale.
ColormapScaleFlags :: bit_set[ColormapScaleFlag; i32]
ColormapScaleFlag :: enum i32 {
	NoLabel = 0,
	Opposite = 1,
	Invert = 2,
}

// ImPlotItemFlags, mostly relevant when adding custom items.
ItemFlags :: bit_set[ItemFlag; i32]
ItemFlag :: enum i32 {
	NoLegend = 0,
	NoFit = 1,
}

// ImPlotCond, same values as ImGuiCond.
Cond :: enum i32 {
	None = 0,
	Always = 1,
	Once = 2,
}

// ImPlotCol for PushStyleColor.
Col :: enum i32 {
	FrameBg = 0,
	PlotBg = 1,
	PlotBorder = 2,
	LegendBg = 3,
	LegendBorder = 4,
	LegendText = 5,
	TitleText = 6,
	InlayText = 7,
	AxisText = 8,
	AxisGrid = 9,
	AxisTick = 10,
	AxisBg = 11,
	AxisBgHovered = 12,
	AxisBgActive = 13,
	Selection = 14,
	Crosshairs = 15,
	Count = 16,
}
COL_COUNT :: 16

// ImPlotStyleVar for PushStyleVar.
StyleVar :: enum i32 {
	PlotDefaultSize = 0,
	PlotMinSize,
	PlotBorderSize,
	MinorAlpha,
	MajorTickLen,
	MinorTickLen,
	MajorTickSize,
	MinorTickSize,
	MajorGridSize,
	MinorGridSize,
	PlotPadding,
	LabelPadding,
	LegendPadding,
	LegendInnerPadding,
	LegendSpacing,
	MousePosPadding,
	AnnotationPadding,
	FitPadding,
	DigitalPadding,
	DigitalSpacing,
	Count,
}
STYLE_VAR_COUNT :: 20

// ImPlotScale for SetupAxisScale.
Scale :: enum i32 {
	Linear = 0,
	Time = 1,
	Log10 = 2,
	SymLog = 3,
}

// ImPlotMarker for the Spec marker field.
Marker :: enum i32 {
	None = -2,
	Auto = -1,
	Circle = 0,
	Square = 1,
	Diamond = 2,
	Up = 3,
	Down = 4,
	Left = 5,
	Right = 6,
	Cross = 7,
	Plus = 8,
	Asterisk = 9,
	Count = 10,
}
MARKER_COUNT :: 10

// ImPlotColormap, the built-in color maps.
Colormap :: enum i32 {
	Deep = 0,
	Dark = 1,
	Pastel = 2,
	Paired = 3,
	Viridis = 4,
	Plasma = 5,
	Hot = 6,
	Cool = 7,
	Pink = 8,
	Jet = 9,
	Twilight = 10,
	RdBu = 11,
	BrBG = 12,
	PiYG = 13,
	Spectral = 14,
	Greys = 15,
}

// ImPlotLocation for the legend, mouse text and annotations.
Location :: enum i32 {
	Center = 0,
	North = 1,
	South = 2,
	West = 4,
	East = 8,
	NorthWest = 5,
	NorthEast = 9,
	SouthWest = 6,
	SouthEast = 10,
}

// ImPlotBin for the histogram binning method.
Bin :: enum i32 {
	Sqrt = -1,
	Sturges = -2,
	Rice = -3,
	Scott = -4,
}

// ImPlotDateFmt for FormatDate and the DateTimeSpec.
DateFmt :: enum i32 {
	None = 0,
	DayMo = 1,
	DayMoYr = 2,
	MoYr = 3,
	Mo = 4,
	Yr = 5,
}

// ImPlotTimeFmt for FormatTime and the DateTimeSpec.
TimeFmt :: enum i32 {
	None = 0,
	Us = 1,
	SUs = 2,
	SMs = 3,
	S = 4,
	MinSMs = 5,
	HrMinSMs = 6,
	HrMinS = 7,
	HrMin = 8,
	Hr = 9,
}

// ImPlotTimeUnit for AddTime / FloorTime / CeilTime / RoundTime.
TimeUnit :: enum i32 {
	Us = 0,
	Ms = 1,
	S = 2,
	Min = 3,
	Hr = 4,
	Day = 5,
	Mo = 6,
	Yr = 7,
	Count = 8,
}

// ImPlotContext, opaque.
Context :: struct {}

// ImPlotPoint: a data point in plot (double) coordinates.
Point :: struct {
	x: f64,
	y: f64,
}

// ImPlotRange: an interval [Min, Max].
Range :: struct {
	Min: f64,
	Max: f64,
}

// ImPlotRect: an axis-aligned rectangle made of two ranges.
Rect :: struct {
	X: Range,
	Y: Range,
}

// ImPlotTime: a timestamp, seconds plus microseconds.
Time :: struct {
	S:  i64,
	Us: i32,
}

// ImPlotDateTimeSpec: date/time formatting preferences.
DateTimeSpec :: struct {
	Date:           DateFmt,
	Time:           TimeFmt,
	UseISO8601:     bool,
	Use24HourClock: bool,
}

// ImPlotSpec: per-item plot settings. A zeroed Spec means "use defaults",
// matching the C API.
Spec :: struct {
	LineColor:        im.Vec4,
	LineColors:       [^]u32,
	LineWeight:       f32,
	FillColor:        im.Vec4,
	FillColors:       [^]u32,
	FillAlpha:        f32,
	Marker:           Marker,
	MarkerSize:       f32,
	MarkerSizes:      [^]f32,
	MarkerLineColor:  im.Vec4,
	MarkerLineColors: [^]u32,
	MarkerFillColor:  im.Vec4,
	MarkerFillColors: [^]u32,
	Size:             f32,
	Offset:           i32,
	Stride:           i32,
	Flags:            ItemFlags,
}

// ImPlotStyle, the full plot style. Access it through GetStyle().
Style :: struct {
	PlotDefaultSize:    im.Vec2,
	PlotMinSize:        im.Vec2,
	PlotBorderSize:     f32,
	MinorAlpha:         f32,
	MajorTickLen:       im.Vec2,
	MinorTickLen:       im.Vec2,
	MajorTickSize:      im.Vec2,
	MinorTickSize:      im.Vec2,
	MajorGridSize:      im.Vec2,
	MinorGridSize:      im.Vec2,
	PlotPadding:        im.Vec2,
	LabelPadding:       im.Vec2,
	LegendPadding:      im.Vec2,
	LegendInnerPadding: im.Vec2,
	LegendSpacing:      im.Vec2,
	MousePosPadding:    im.Vec2,
	AnnotationPadding:  im.Vec2,
	FitPadding:         im.Vec2,
	DigitalPadding:     f32,
	DigitalSpacing:     f32,
	Colors:             [COL_COUNT]im.Vec4,
	Colormap:           Colormap,
	UseLocalTime:       bool,
	UseISO8601:         bool,
	Use24HourClock:     bool,
}

// ImPlotInputMap, the mouse/keyboard mapping, accessed through GetInputMap().
InputMap :: struct {
	Pan:           im.MouseButton,
	PanMod:        i32,
	Fit:           im.MouseButton,
	Select:        im.MouseButton,
	SelectCancel:  im.MouseButton,
	SelectMod:     i32,
	SelectHorzMod: i32,
	SelectVertMod: i32,
	Menu:          im.MouseButton,
	OverrideMod:   i32,
	ZoomMod:       i32,
	ZoomRate:      f32,
}

// Callbacks used by ImPlot.
Formatter :: #type proc(value: f64, buff: [^]u8, size: i32, user_data: rawptr) -> i32
Getter :: #type proc(idx: i32, user_data: rawptr) -> Point
Transform :: #type proc(value: f64, user_data: rawptr) -> f64
Locator :: #type proc(ticker: rawptr, range: Range, pixels: f32, vertical: bool, formatter: Formatter, formatter_data: rawptr)

@(default_calling_convention = "c")
foreign implotlib {

	// Context management
	@(link_name = "ImPlot_CreateContext")
	CreateContext :: proc() -> ^Context ---

	@(link_name = "ImPlot_DestroyContext")
	DestroyContext :: proc(ctx: ^Context) ---

	@(link_name = "ImPlot_GetCurrentContext")
	GetCurrentContext :: proc() -> ^Context ---

	@(link_name = "ImPlot_SetCurrentContext")
	SetCurrentContext :: proc(ctx: ^Context) ---

	@(link_name = "ImPlot_SetImGuiContext")
	SetImGuiContext :: proc(ctx: ^im.Context) ---

	// Plot lifecycle
	@(link_name = "ImPlot_BeginPlot")
	BeginPlot :: proc(title_id: cstring, size: im.Vec2, flags: Flags) -> bool ---

	@(link_name = "ImPlot_EndPlot")
	EndPlot :: proc() ---

	@(link_name = "ImPlot_BeginSubplots")
	BeginSubplots :: proc(title_id: cstring, rows: i32, cols: i32, size: im.Vec2, flags: SubplotFlags, row_ratios: [^]f32, col_ratios: [^]f32) -> bool ---

	@(link_name = "ImPlot_EndSubplots")
	EndSubplots :: proc() ---

	// Setup
	@(link_name = "ImPlot_SetupAxis")
	SetupAxis :: proc(axis: Axis, label: cstring, flags: AxisFlags) ---

	@(link_name = "ImPlot_SetupAxisLimits")
	SetupAxisLimits :: proc(axis: Axis, v_min: f64, v_max: f64, cond: Cond) ---

	@(link_name = "ImPlot_SetupAxisLinks")
	SetupAxisLinks :: proc(axis: Axis, link_min: ^f64, link_max: ^f64) ---

	@(link_name = "ImPlot_SetupAxisFormat_Str")
	SetupAxisFormat :: proc(axis: Axis, fmt: cstring) ---

	@(link_name = "ImPlot_SetupAxisFormat_PlotFormatter")
	SetupAxisFormat_PlotFormatter :: proc(axis: Axis, formatter: Formatter, data: rawptr) ---

	@(link_name = "ImPlot_SetupAxisTicks_doublePtr")
	SetupAxisTicks :: proc(axis: Axis, values: [^]f64, n_ticks: i32, labels: [^]cstring, keep_default: bool) ---

	@(link_name = "ImPlot_SetupAxisTicks_double")
	SetupAxisTicks_double :: proc(axis: Axis, v_min: f64, v_max: f64, n_ticks: i32, labels: [^]cstring, keep_default: bool) ---

	@(link_name = "ImPlot_SetupAxisScale_PlotScale")
	SetupAxisScale :: proc(axis: Axis, scale: Scale) ---

	@(link_name = "ImPlot_SetupAxisScale_PlotTransform")
	SetupAxisScale_PlotTransform :: proc(axis: Axis, forward: Transform, inverse: Transform, data: rawptr) ---

	@(link_name = "ImPlot_SetupAxisLimitsConstraints")
	SetupAxisLimitsConstraints :: proc(axis: Axis, v_min: f64, v_max: f64) ---

	@(link_name = "ImPlot_SetupAxisZoomConstraints")
	SetupAxisZoomConstraints :: proc(axis: Axis, z_min: f64, z_max: f64) ---

	@(link_name = "ImPlot_SetupAxes")
	SetupAxes :: proc(x_label: cstring, y_label: cstring, x_flags: AxisFlags, y_flags: AxisFlags) ---

	@(link_name = "ImPlot_SetupAxesLimits")
	SetupAxesLimits :: proc(x_min: f64, x_max: f64, y_min: f64, y_max: f64, cond: Cond) ---

	@(link_name = "ImPlot_SetupLegend")
	SetupLegend :: proc(location: Location, flags: LegendFlags) ---

	@(link_name = "ImPlot_SetupMouseText")
	SetupMouseText :: proc(location: Location, flags: MouseTextFlags) ---

	@(link_name = "ImPlot_SetupFinish")
	SetupFinish :: proc() ---

	// SetNext helpers
	@(link_name = "ImPlot_SetNextAxisLimits")
	SetNextAxisLimits :: proc(axis: Axis, v_min: f64, v_max: f64, cond: Cond) ---

	@(link_name = "ImPlot_SetNextAxisLinks")
	SetNextAxisLinks :: proc(axis: Axis, link_min: ^f64, link_max: ^f64) ---

	@(link_name = "ImPlot_SetNextAxisToFit")
	SetNextAxisToFit :: proc(axis: Axis) ---

	@(link_name = "ImPlot_SetNextAxesLimits")
	SetNextAxesLimits :: proc(x_min: f64, x_max: f64, y_min: f64, y_max: f64, cond: Cond) ---

	@(link_name = "ImPlot_SetNextAxesToFit")
	SetNextAxesToFit :: proc() ---

	// PlotLine
	// ImPlotSpec helpers: creates a Spec with proper C defaults (IMPLOT_AUTO = -1).
	// A zeroed Spec{} has LineColor=(0,0,0,0) and LineWeight=0, which is invisible.
	@(link_name = "ImPlotSpec_ImPlotSpec")
	Spec_ImPlotSpec :: proc() -> ^Spec ---

	@(link_name = "ImPlotSpec_destroy")
	Spec_Destroy :: proc(self: ^Spec) ---

	@(link_name = "ImPlotSpec_SetProp_Float")
	Spec_SetProp_Float :: proc(self: ^Spec, prop: Prop, v: f32) ---

	@(link_name = "ImPlotSpec_SetProp_double")
	Spec_SetProp_double :: proc(self: ^Spec, prop: Prop, v: f64) ---

	@(link_name = "ImPlotSpec_SetProp_Vec4")
	Spec_SetProp_Vec4 :: proc(self: ^Spec, prop: Prop, v: im.Vec4) ---

	@(link_name = "ImPlot_PlotLine_FloatPtrInt")
	_PlotLine_FloatPtrInt :: proc(label_id: cstring, values: [^]f32, count: i32, xscale: f64, xstart: f64, spec: ^Spec) ---

	@(link_name = "ImPlot_PlotLine_doublePtrInt")
	_PlotLine_doublePtrInt :: proc(label_id: cstring, values: [^]f64, count: i32, xscale: f64, xstart: f64, spec: ^Spec) ---

	@(link_name = "ImPlot_PlotLine_FloatPtrFloatPtr")
	_PlotLine_FloatPtrFloatPtr :: proc(label_id: cstring, xs: [^]f32, ys: [^]f32, count: i32, spec: ^Spec) ---

	@(link_name = "ImPlot_PlotLine_doublePtrdoublePtr")
	_PlotLine_doublePtrdoublePtr :: proc(label_id: cstring, xs: [^]f64, ys: [^]f64, count: i32, spec: ^Spec) ---

	@(link_name = "ImPlot_PlotLineG")
	_PlotLineG :: proc(label_id: cstring, getter: Getter, data: rawptr, count: i32, spec: ^Spec) ---

	// PlotScatter
	@(link_name = "ImPlot_PlotScatter_FloatPtrInt")
	PlotScatter_FloatPtrInt :: proc(label_id: cstring, values: [^]f32, count: i32, xscale: f64, xstart: f64, spec: Spec) ---

	@(link_name = "ImPlot_PlotScatter_doublePtrInt")
	PlotScatter_doublePtrInt :: proc(label_id: cstring, values: [^]f64, count: i32, xscale: f64, xstart: f64, spec: Spec) ---

	@(link_name = "ImPlot_PlotScatter_FloatPtrFloatPtr")
	PlotScatter_FloatPtrFloatPtr :: proc(label_id: cstring, xs: [^]f32, ys: [^]f32, count: i32, spec: Spec) ---

	@(link_name = "ImPlot_PlotScatter_doublePtrdoublePtr")
	PlotScatter_doublePtrdoublePtr :: proc(label_id: cstring, xs: [^]f64, ys: [^]f64, count: i32, spec: Spec) ---

	@(link_name = "ImPlot_PlotScatterG")
	PlotScatterG :: proc(label_id: cstring, getter: Getter, data: rawptr, count: i32, spec: Spec) ---

	// PlotStairs
	@(link_name = "ImPlot_PlotStairs_FloatPtrInt")
	PlotStairs_FloatPtrInt :: proc(label_id: cstring, values: [^]f32, count: i32, xscale: f64, xstart: f64, spec: Spec) ---

	@(link_name = "ImPlot_PlotStairs_doublePtrInt")
	PlotStairs_doublePtrInt :: proc(label_id: cstring, values: [^]f64, count: i32, xscale: f64, xstart: f64, spec: Spec) ---

	@(link_name = "ImPlot_PlotStairs_FloatPtrFloatPtr")
	PlotStairs_FloatPtrFloatPtr :: proc(label_id: cstring, xs: [^]f32, ys: [^]f32, count: i32, spec: Spec) ---

	@(link_name = "ImPlot_PlotStairs_doublePtrdoublePtr")
	PlotStairs_doublePtrdoublePtr :: proc(label_id: cstring, xs: [^]f64, ys: [^]f64, count: i32, spec: Spec) ---

	@(link_name = "ImPlot_PlotStairsG")
	PlotStairsG :: proc(label_id: cstring, getter: Getter, data: rawptr, count: i32, spec: Spec) ---

	// PlotShaded
	@(link_name = "ImPlot_PlotShaded_FloatPtrInt")
	PlotShaded_FloatPtrInt :: proc(label_id: cstring, values: [^]f32, count: i32, yref: f64, xscale: f64, xstart: f64, spec: Spec) ---

	@(link_name = "ImPlot_PlotShaded_doublePtrInt")
	PlotShaded_doublePtrInt :: proc(label_id: cstring, values: [^]f64, count: i32, yref: f64, xscale: f64, xstart: f64, spec: Spec) ---

	@(link_name = "ImPlot_PlotShaded_FloatPtrFloatPtrInt")
	PlotShaded_FloatPtrFloatPtrInt :: proc(label_id: cstring, xs: [^]f32, ys: [^]f32, count: i32, yref: f64, spec: Spec) ---

	@(link_name = "ImPlot_PlotShaded_doublePtrdoublePtrInt")
	PlotShaded_doublePtrdoublePtrInt :: proc(label_id: cstring, xs: [^]f64, ys: [^]f64, count: i32, yref: f64, spec: Spec) ---

	@(link_name = "ImPlot_PlotShaded_FloatPtrFloatPtrFloatPtr")
	PlotShaded_FloatPtrFloatPtrFloatPtr :: proc(label_id: cstring, xs: [^]f32, ys1: [^]f32, ys2: [^]f32, count: i32, spec: Spec) ---

	@(link_name = "ImPlot_PlotShaded_doublePtrdoublePtrdoublePtr")
	PlotShaded_doublePtrdoublePtrdoublePtr :: proc(label_id: cstring, xs: [^]f64, ys1: [^]f64, ys2: [^]f64, count: i32, spec: Spec) ---

	@(link_name = "ImPlot_PlotShadedG")
	PlotShadedG :: proc(label_id: cstring, getter1: Getter, data1: rawptr, getter2: Getter, data2: rawptr, count: i32, spec: Spec) ---

	// PlotBars
	@(link_name = "ImPlot_PlotBars_FloatPtrInt")
	PlotBars_FloatPtrInt :: proc(label_id: cstring, values: [^]f32, count: i32, bar_size: f64, shift: f64, spec: Spec) ---

	@(link_name = "ImPlot_PlotBars_doublePtrInt")
	PlotBars_doublePtrInt :: proc(label_id: cstring, values: [^]f64, count: i32, bar_size: f64, shift: f64, spec: Spec) ---

