	PlotBars_FloatPtrFloatPtr :: proc(label_id: cstring, xs: [^]f32, ys: [^]f32, count: i32, bar_size: f64, spec: Spec) ---

	@(link_name = "ImPlot_PlotBars_doublePtrdoublePtr")
	PlotBars_doublePtrdoublePtr :: proc(label_id: cstring, xs: [^]f64, ys: [^]f64, count: i32, bar_size: f64, spec: Spec) ---

