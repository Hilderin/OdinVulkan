package ovk

// Global types
color4 :: [4]f32

COLOR_WHITE: color4 : {1.0, 1.0, 1.0, 1.0}
COLOR_BLACK: color4 : {0.0, 0.0, 0.0, 1.0}
COLOR_RED: color4 : {1.0, 0.0, 0.0, 1.0}
COLOR_GREEN: color4 : {0.0, 1.0, 0.0, 1.0}
COLOR_BLUE: color4 : {0.0, 0.0, 1.0, 1.0}
COLOR_YELLOW: color4 : {1.0, 1.0, 0.0, 1.0}
COLOR_CYAN: color4 : {0.0, 1.0, 1.0, 1.0}
COLOR_MAGENTA: color4 : {1.0, 0.0, 1.0, 1.0}
COLOR_ORANGE: color4 : {1.0, 0.5, 0.0, 1.0}
COLOR_PURPLE: color4 : {0.5, 0.0, 0.5, 1.0}
COLOR_PINK: color4 : {1.0, 0.75, 0.8, 1.0}
COLOR_BROWN: color4 : {0.6, 0.3, 0.1, 1.0}
COLOR_LIGHT_GRAY: color4 : {0.75, 0.75, 0.75, 1.0}
COLOR_GRAY: color4 : {0.5, 0.5, 0.5, 1.0}
COLOR_DARK_GRAY: color4 : {0.25, 0.25, 0.25, 1.0}
COLOR_TRANSPARENT: color4 : {0.0, 0.0, 0.0, 0.0}
