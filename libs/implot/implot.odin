	PlotBarsG :: proc(label_id: cstring, getter: Getter, data: rawptr, count: i32, bar_size: f64, spec: Spec) ---

	// PlotBarGroups
	@(link_name = "ImPlot_PlotBarGroups_FloatPtr")
	PlotBarGroups_FloatPtr :: proc(label_ids: [^]cstring, values: [^]f32, item_count: i32, group_count: i32, group_size: f64, shift: f64, spec: Spec) ---

	@(link_name = "ImPlot_PlotBarGroups_doublePtr")
	PlotBarGroups_doublePtr :: proc(label_ids: [^]cstring, values: [^]f64, item_count: i32, group_count: i32, group_size: f64, shift: f64, spec: Spec) ---

	// PlotErrorBars
	@(link_name = "ImPlot_PlotErrorBars_FloatPtrFloatPtrFloatPtrInt")
